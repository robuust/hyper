{
    "name": "verbb/hyper",
    "description": "A Craft CMS field for creating consistent links and calls to action.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "hyper"
    ],
    "support": {
        "email": "support@verbb.io",
        "issues": "https://github.com/verbb/hyper/issues?state=open",
        "source": "https://github.com/verbb/hyper",
        "docs": "https://github.com/verbb/hyper",
        "rss": "https://github.com/verbb/hyper/commits/v2.atom"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Verbb",
            "homepage": "https://verbb.io"
        }
    ],
    "require": {
        "php": "^8.5",
        "craftcms/cms": "6.0.0-beta.1",
        "embed/embed": "^3.0.0 || ^4.0.0",
        "nystudio107/craft-plugin-vite": "dev-feature/craft6-beta1-compatibility",
        "verbb/base": "dev-feature/craft-6-beta",
        "craftcms/yii2-adapter": "6.0.0-beta.1"
    },
    "autoload": {
        "psr-4": {
            "verbb\\hyper\\": "src/"
        }
    },
    "extra": {
        "name": "Hyper",
        "handle": "hyper",
        "changelogUrl": "https://raw.githubusercontent.com/verbb/hyper/craft-5/CHANGELOG.md",
        "class": "verbb\\hyper\\Hyper"
    },
    "scripts": {
        "test:class-resolution-regressions": "@php tests/regression/class-resolution.php"
    }
}
